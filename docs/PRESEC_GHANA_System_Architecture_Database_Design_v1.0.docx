6. API STRUCTURE
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Base URL: http://localhost:3000/api/v1

Module Endpoints:

     /auth                    → register, login, me
     /schools                 → list, get by ID
     /alumni                  → search, me, verify
     /events                  → CRUD, register, check-in
     /projects                → CRUD, contribute, updates
     /announcements           → CRUD
     /heritage                → CRUD, achievements
     /gallery                 → albums, photos
     /opportunities           → CRUD, apply, applications
     /mentorship              → offers, requests
     /businesses              → CRUD, verify

Total endpoints: 60+

[PAGE BREAK]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
7. AUTHENTICATION & AUTHORIZATION
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

7.1  AUTHENTICATION

     •  Users register with email + password
     •  Password hashed with bcrypt (10+ rounds)
     •  Login returns JWT access token (7-day expiry)
     •  Token contains user ID, email, and role
     •  Token sent in Authorization: Bearer <token> header

7.2  AUTHORIZATION

     Role-Based Access Control (RBAC):

     ┌─────────────────┬────────────────────────────────────────────┐
     │ ROLE            │ PERMISSIONS                                │
     ├─────────────────┼────────────────────────────────────────────┤
     │ student         │ View opportunities, mentorship, events     │
     │ alumni          │ Above + alumni directory, jobs, events     │
     │ teacher         │ Above + school-specific features           │
     │ admin           │ Above + manage school content              │
     │ super_admin     │ Full platform access                       │
     └─────────────────┴────────────────────────────────────────────┘

[PAGE BREAK]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
8. SECURITY CONSIDERATIONS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

     •  Passwords hashed with bcrypt
     •  JWT tokens with expiration
     •  HTTPS in production
     •  Environment variables for secrets
     •  Input validation on all endpoints
     •  SQL injection prevention via TypeORM
     •  Rate limiting (planned)
     •  CORS configured for allowed origins only
     •  File upload restrictions (size, type)
     •  Audit logging for admin actions

[PAGE BREAK]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
9. SCALABILITY PLAN
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Phase 1 (Current): Single server, single database
Phase 2: Add CDN for static assets
Phase 3: Add caching layer (Redis)
Phase 4: Add read replicas for database
Phase 5: Load balancing across multiple API servers
Phase 6: Microservices for high-traffic modules

