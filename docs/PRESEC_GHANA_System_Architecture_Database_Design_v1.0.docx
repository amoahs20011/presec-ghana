1. ARCHITECTURE OVERVIEW
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PRESEC GHANA uses a modern three-tier architecture:

    ┌──────────────────────────────────────────────────────────┐
    │                    CLIENT LAYER                          │
    │  ┌────────────┐  ┌────────────┐  ┌────────────────────┐ │
    │  │  Website   │  │ Mobile App │  │   Admin Portal     │ │
    │  │ (Next.js)  │  │ (Flutter)  │  │   (Next.js)        │ │
    │  └────────────┘  └────────────┘  └────────────────────┘ │
    └──────────────────────────────────────────────────────────┘
                              │
                              ▼
    ┌──────────────────────────────────────────────────────────┐
    │                  APPLICATION LAYER                       │
    │              NestJS REST API (Node.js)                   │
    │  ┌─────────┬─────────┬─────────┬─────────┬─────────┐    │
    │  │  Auth   │ Users   │ Alumni  │ Events  │ etc...  │    │
    │  └─────────┴─────────┴─────────┴─────────┴─────────┘    │
    └──────────────────────────────────────────────────────────┘
                              │
                              ▼
    ┌──────────────────────────────────────────────────────────┐
    │                     DATA LAYER                           │
    │   ┌──────────────┐  ┌──────────────┐  ┌─────────────┐  │
    │   │ PostgreSQL   │  │   Storage    │  │Notifications│  │
    │   │  Database    │  │  (Cloudinary)│  │ (Firebase)  │  │
    │   └──────────────┘  └──────────────┘  └─────────────┘  │
    └──────────────────────────────────────────────────────────┘

[PAGE BREAK]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2. TECHNOLOGY STACK
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

┌────────────────────┬──────────────────────────────────────────────────┐
│ LAYER              │ TECHNOLOGY                                       │
├────────────────────┼──────────────────────────────────────────────────┤
│ Frontend (Web)     │ Next.js 16, TypeScript, Tailwind CSS             │
│ Backend            │ NestJS 12, Node.js 24                            │
│ Database           │ PostgreSQL 18                                    │
│ ORM                │ TypeORM                                          │
│ Authentication     │ JWT, Passport.js                                 │
│ Password Hashing   │ bcrypt                                           │
│ API Documentation  │ Swagger / OpenAPI                                │
│ Mobile             │ Flutter (Phase 8)                                │
│ File Storage       │ Cloudinary / Firebase Storage                    │
│ Notifications      │ Firebase Cloud Messaging                         │
│ Payments           │ Mobile Money, Paystack                           │
│ Hosting            │ TBD (cloud or self-hosted)                       │
│ Version Control    │ Git + GitHub                                     │
│ CI/CD              │ GitHub Actions (planned)                         │
└────────────────────┴──────────────────────────────────────────────────┘

[PAGE BREAK]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
3. SYSTEM LAYERS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

3.1  PRESENTATION LAYER

     •  Public Website — accessible to everyone
     •  Alumni Portal — authenticated users
     •  Admin Dashboard — administrative users
     •  Mobile App — Android/iOS (Phase 8)

3.2  APPLICATION LAYER

     •  REST API with versioned endpoints (/api/v1/)
     •  Modular NestJS architecture
     •  JWT-based authentication
     •  Role-based access control
     •  Request validation and sanitization
     •  Error handling and logging

3.3  DATA LAYER

     •  PostgreSQL relational database
     •  TypeORM for object-relational mapping
     •  Migrations for schema versioning
     •  Indexes for performance
     •  Foreign key constraints for integrity

3.4  INFRASTRUCTURE LAYER

     •  Cloud storage for media files
     •  Notification service
     •  Payment gateway integration
     •  Email service (planned)

[PAGE BREAK]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
4. DATABASE SCHEMA
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

4.1  GEOGRAPHIC HIERARCHY

     regions (16 Ghana regions)
         │
         └──► districts (many per region)
                 │
                 └──► schools (many per district)
                         │
                         └──► year_groups (many per school)
                                 │
                                 └──► year_group_members

4.2  USER HIERARCHY

     users (base authentication table)
         │
         ├──► alumni_profiles (for alumni)
         ├──► staff_profiles (for teachers/staff)
         └──► role field: student | alumni | teacher | admin | super_admin

4.3  OPPORTUNITY SYSTEM

     opportunities (jobs, scholarships, internships, training)
         │
         └──► opportunity_applications

4.4  EVENT SYSTEM

     events (reunions, homecomings, gatherings)
         │
         └──► event_registrations (with QR tickets)

4.5  DEVELOPMENT SYSTEM

     projects (school development projects)
         │
         ├──► contributions (donations)
         └──► project_updates (progress tracking)

4.6  HERITAGE SYSTEM

     heritage_items (photos, documents, artifacts)
     achievements (academic, sports, alumni)

4.7  MENTORSHIP SYSTEM

     mentorship_offers (mentors)
         │
         └──► mentorship_requests (mentee requests)

4.8  OTHER SYSTEMS

     •  announcements (news and notices)
     •  businesses (alumni business directory)
     •  gallery_albums / gallery_photos (photo galleries)

